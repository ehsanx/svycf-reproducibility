# Cluster settings for scripts/*/submit.sh and setup.sh. Copy to config/slurm.env and edit; config/slurm.env is
# ignored by git. Leave a value empty to use the cluster's default.
SLURM_ACCOUNT=""          # your allocation (sbatch --account)
SLURM_PARTITION=""        # sbatch --partition, if your cluster needs one
SLURM_MAIL=""             # e-mail for failed jobs (sbatch --mail-user)
SLURM_EXTRA=""            # any further sbatch options, e.g. "--qos=normal"
SIM_MODULES=""            # modules for the simulation, e.g. "gcc/9.4.0 r/4.4.0" (the recorded runs)
SPA_MODULES=""            # modules for the SPA analysis (the recorded runs used the same two)
SPA_RUN_TIME="01:00:00"   # walltime of one resample chunk (64 resamples on 32 cores)
SPA_REF_TIME="05:30:00"   # walltime of the reference splits (20 splits on 20 cores)
